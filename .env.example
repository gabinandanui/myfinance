# MongoDB connection string
# Use standard format if SRV resolution fails:
# MONGODB_URI=mongodb://user:pass@host1:27017,host2:27017/DBName?ssl=true&authSource=admin
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/MyExpenseDB

# Node Environment
NODE_ENV=development

# Backend URL for Frontend (Required for local development)
VITE_API_URL=http://localhost:4000/api

# Server Port
PORT=4000

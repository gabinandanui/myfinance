{
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "fin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "fin/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "fin/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "fin/dist/index.html"
    }
  ]
}


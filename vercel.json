{
  "version": 2,
  "buildCommand": "cd fin && npm ci && npm run build",
  "outputDirectory": "fin/dist",
  "installCommand": "cd fin && npm ci",
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

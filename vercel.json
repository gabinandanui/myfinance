{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "env": {
    "MONGODB_URI": "",
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "file" }],
      "destination": "/fin/dist/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/fin/dist/index.html"
    }
  ]
}
